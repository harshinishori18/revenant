# Free option, no credit card required. Get a key at https://console.groq.com
# (sign in, API Keys, Create API Key). This is all you need.
GROQ_API_KEY=

# Optional: pin a different Groq model if the default is retired.
# COPILOT_MODEL=llama-3.3-70b-versatile

# Optional paid alternative. If this is set and GROQ_API_KEY is not, it is used.
ANTHROPIC_API_KEY=
